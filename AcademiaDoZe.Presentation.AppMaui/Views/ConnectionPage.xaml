<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ConnectionPage"
             Title="Entrar">
  <Grid>
    <ScrollView>
      <Grid Padding="24,112,24,112" MinimumHeightRequest="600">
      <Border Padding="32"
              Background="{AppThemeBinding Light={StaticResource CardPurpleGradient}, Dark={StaticResource CardDarkGradient}}"
              Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
              StrokeThickness="1"
              StrokeShape="RoundRectangle 24"
              VerticalOptions="Center"
              HorizontalOptions="Center"
              MaximumWidthRequest="440">
        <Border.Shadow>
          <Shadow Brush="#70000000" Opacity="0.16" Radius="24" Offset="0,10" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="18">
          <VerticalStackLayout Spacing="5">
            <Label Text="Bem-vindo de volta"
                   FontSize="27"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />
            <Label Text="Entre com suas credenciais para continuar."
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource TextPlaceholderLight}, Dark={StaticResource TextPlaceholderDark}}"
                   HorizontalTextAlignment="Center" />
          </VerticalStackLayout>

          <VerticalStackLayout Spacing="8">
            <Label Text="USUÁRIO"
                   FontSize="12"
                   CharacterSpacing="1"
                   FontAttributes="Bold" />
            <Border HeightRequest="56"
                    Padding="14,0"
                    Background="{AppThemeBinding Light={StaticResource InputPurpleGradient}, Dark={StaticResource InputDarkGradient}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 14">
              <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                <Label Text="&#xe7fd;"
                       FontFamily="MaterialIcons"
                       FontSize="28"
                       TextColor="#8B5CF6"
                       VerticalTextAlignment="Center" />
                <Entry Grid.Column="1"
                       Text="{Binding Username}"
                       Placeholder="Digite seu usuário"
                       BackgroundColor="Transparent"
                       ClearButtonVisibility="WhileEditing"
                       ReturnType="Next"
                       VerticalOptions="Center" />
              </Grid>
            </Border>
          </VerticalStackLayout>

          <VerticalStackLayout Spacing="8">
            <Label Text="SENHA"
                   FontSize="12"
                   CharacterSpacing="1"
                   FontAttributes="Bold" />
            <Border HeightRequest="56"
                    Padding="14,0"
                    Background="{AppThemeBinding Light={StaticResource InputPurpleGradient}, Dark={StaticResource InputDarkGradient}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                    StrokeShape="RoundRectangle 14">
              <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                <Label Text="&#xe897;"
                       FontFamily="MaterialIcons"
                       FontSize="28"
                       TextColor="#8B5CF6"
                       VerticalTextAlignment="Center" />
                <Entry Grid.Column="1"
                       Text="{Binding Password}"
                       Placeholder="Digite sua senha"
                       IsPassword="True"
                       BackgroundColor="Transparent"
                       ReturnType="Go"
                       VerticalOptions="Center" />
              </Grid>
            </Border>
          </VerticalStackLayout>

          <Button Text="Entrar"
                  Command="{Binding ConnectCommand}"
                  HeightRequest="54"
                  CornerRadius="15"
                  FontSize="16"
                  FontAttributes="Bold"
                  TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                  Background="{AppThemeBinding Light={StaticResource ButtonPurpleGradient}, Dark={StaticResource ButtonDarkGradient}}">
            <Button.ImageSource>
              <FontImageSource FontFamily="MaterialIcons" Glyph="&#xe0be;" Size="26" Color="#8B5CF6" />
            </Button.ImageSource>
          </Button>

          <ActivityIndicator IsRunning="{Binding IsConnecting}"
                             IsVisible="{Binding IsConnecting}"
                             HorizontalOptions="Center"
                             Color="#8B5CF6" />
          <Label Text="{Binding StatusMessage}"
                 FontSize="13"
                 TextColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}"
                 HorizontalTextAlignment="Center"
                 LineBreakMode="WordWrap" />
        </VerticalStackLayout>
      </Border>
      </Grid>
    </ScrollView>

    <VerticalStackLayout HorizontalOptions="End"
                         VerticalOptions="Start"
                         Margin="0,12,20,0"
                         Spacing="2"
                         InputTransparent="True">
      <Image Source="academiadoze.png"
             WidthRequest="64"
             HeightRequest="64"
             Aspect="AspectFit" />
      <Label Text="Academia do Zé"
             FontSize="11"
             FontAttributes="Bold"
             TextColor="#8B5CF6"
             HorizontalTextAlignment="Center" />
    </VerticalStackLayout>
  </Grid>
</ContentPage>
