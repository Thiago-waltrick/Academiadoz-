<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ProfilePage"
             Title="Meu perfil">
  <ScrollView>
    <Grid Padding="24,24,24,112">
      <Border Padding="28"
              Background="{AppThemeBinding Light={StaticResource CardPurpleGradient}, Dark={StaticResource CardDarkGradient}}"
              Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
              StrokeShape="RoundRectangle 24"
              HorizontalOptions="Center"
              VerticalOptions="Start"
              MaximumWidthRequest="520">
        <VerticalStackLayout Spacing="18">
          <VerticalStackLayout Spacing="4">
            <Label Text="Meu perfil"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center" />
            <Label Text="Personalize seu nome e sua foto."
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource TextPlaceholderLight}, Dark={StaticResource TextPlaceholderDark}}"
                   HorizontalTextAlignment="Center" />
          </VerticalStackLayout>

          <Border WidthRequest="132"
                  HeightRequest="132"
                  Padding="4"
                  HorizontalOptions="Center"
                  Background="{StaticResource ButtonDarkGradient}"
                  Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                  StrokeShape="Ellipse">
            <Grid>
              <Label Text="&#xe7fd;"
                     FontFamily="MaterialIcons"
                     FontSize="72"
                     TextColor="White"
                     HorizontalTextAlignment="Center"
                     VerticalTextAlignment="Center" />
              <Image Source="{Binding ProfileImagePath}"
                     Aspect="AspectFill" />
            </Grid>
          </Border>

          <Button Text="Escolher foto"
                  Command="{Binding ChooseImageCommand}"
                  HorizontalOptions="Center"
                  CornerRadius="14"
                  Padding="20,10" />

          <VerticalStackLayout Spacing="8">
            <Label Text="NOME DE EXIBIÇÃO"
                   FontSize="12"
                   CharacterSpacing="1"
                   FontAttributes="Bold" />
            <Entry Text="{Binding DisplayName}"
                   Placeholder="Digite seu nome"
                   Background="{AppThemeBinding Light={StaticResource InputPurpleGradient}, Dark={StaticResource InputDarkGradient}}" />
            <Button Text="Salvar nome"
                    Command="{Binding SaveProfileCommand}"
                    CornerRadius="14"
                    HeightRequest="50" />
          </VerticalStackLayout>

          <BoxView HeightRequest="1"
                   Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

          <VerticalStackLayout Spacing="8">
            <Label Text="CREDENCIAIS SQL SERVER"
                   FontSize="12"
                   CharacterSpacing="1"
                   FontAttributes="Bold" />
            <Label Text="Usuário" FontSize="13" />
            <Entry Text="{Binding SqlUsername}"
                   IsReadOnly="True"
                   Background="{AppThemeBinding Light={StaticResource InputPurpleGradient}, Dark={StaticResource InputDarkGradient}}" />
            <Label Text="Senha" FontSize="13" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <Entry Text="{Binding SqlPassword}"
                     IsPassword="{Binding IsPasswordHidden}"
                     IsReadOnly="True"
                     Placeholder="Senha não salva"
                     Background="{AppThemeBinding Light={StaticResource InputPurpleGradient}, Dark={StaticResource InputDarkGradient}}" />
              <Button Grid.Column="1"
                      Text="{Binding PasswordVisibilityText}"
                      Command="{Binding TogglePasswordVisibilityCommand}"
                      Padding="12,0"
                      CornerRadius="12" />
            </Grid>
          </VerticalStackLayout>

          <Label Text="{Binding StatusMessage}"
                 FontSize="13"
                 TextColor="{AppThemeBinding Light={StaticResource TextPlaceholderLight}, Dark={StaticResource TextPlaceholderDark}}"
                 HorizontalTextAlignment="Center"
                 LineBreakMode="WordWrap" />
        </VerticalStackLayout>
      </Border>
    </Grid>
  </ScrollView>
</ContentPage>
