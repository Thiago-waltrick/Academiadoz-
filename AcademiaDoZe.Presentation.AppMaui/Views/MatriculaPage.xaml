<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AcademiaDoZe.Presentation.AppMaui.Views.MatriculaPage"
             Title="{Binding Title}">
  <ScrollView>
    <VerticalStackLayout Padding="16" Spacing="14">
      <Label Text="{Binding ErrorMessage}"
             TextColor="{AppThemeBinding Light={StaticResource ErrorLight}, Dark={StaticResource ErrorDark}}" />

      <Border Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 12">
        <VerticalStackLayout Spacing="10">
          <Label Text="Aluno" FontAttributes="Bold" FontSize="18" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <SearchBar Placeholder="Buscar por CPF"
                       Text="{Binding CpfBusca}"
                       SearchCommand="{Binding SearchByCpfCommand}" />
            <Button Grid.Column="1" Text="Pesquisar" Command="{Binding SearchByCpfCommand}" />
          </Grid>
          <Grid ColumnDefinitions="76,*" ColumnSpacing="12">
            <Border WidthRequest="72" HeightRequest="72" Stroke="#8B5CF6" StrokeThickness="2" StrokeShape="Ellipse" Padding="0">
              <Image Source="{Binding FotoAluno}" Aspect="AspectFill" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
              <Label Text="{Binding AlunoSelecionado.Nome}" FontAttributes="Bold" />
              <Label Text="{Binding AlunoSelecionado.Cpf, StringFormat='CPF: {0}'}" />
              <Label Text="{Binding AlunoSelecionado.DataNascimento, StringFormat='Nascimento: {0:dd/MM/yyyy}'}" />
            </VerticalStackLayout>
          </Grid>
        </VerticalStackLayout>
      </Border>

      <Border Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 12">
        <VerticalStackLayout Spacing="10">
          <Label Text="Plano e vigência" FontAttributes="Bold" FontSize="18" />
          <Picker Title="Selecione o plano"
                  ItemsSource="{Binding Planos}"
                  SelectedItem="{Binding PlanoSelecionado}" />
          <DatePicker Date="{Binding DataInicio}" />
          <Label Text="{Binding DataFim, StringFormat='Término: {0:dd/MM/yyyy}'}" FontAttributes="Bold" />
        </VerticalStackLayout>
      </Border>

      <Border Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 12">
        <VerticalStackLayout Spacing="10">
          <Label Text="Objetivo" FontAttributes="Bold" FontSize="18" />
          <Editor Text="{Binding Objetivo}" Placeholder="Objetivo do aluno" AutoSize="TextChanges" />
          <Label Text="Restrições e observações" FontAttributes="Bold" FontSize="18" />
          <VerticalStackLayout BindableLayout.ItemsSource="{Binding RestricoesDisponiveis}">
            <BindableLayout.ItemTemplate>
              <DataTemplate>
                <HorizontalStackLayout Spacing="8">
                  <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                  <Label Text="{Binding Nome}" VerticalOptions="Center" />
                </HorizontalStackLayout>
              </DataTemplate>
            </BindableLayout.ItemTemplate>
          </VerticalStackLayout>
          <Editor Text="{Binding ObservacoesRestricao}" Placeholder="Observações (opcional)" AutoSize="TextChanges" />
        </VerticalStackLayout>
      </Border>

      <Border Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 12">
        <VerticalStackLayout Spacing="10">
          <Label Text="Laudo médico (opcional)" FontAttributes="Bold" FontSize="18" />
          <Label Text="{Binding LaudoStatus}" LineBreakMode="MiddleTruncation" />
          <HorizontalStackLayout Spacing="8">
            <Button Text="Anexar laudo" Command="{Binding AttachLaudoCommand}" />
            <Button Text="Remover" Command="{Binding RemoveLaudoCommand}" />
          </HorizontalStackLayout>
        </VerticalStackLayout>
      </Border>

      <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
      <HorizontalStackLayout HorizontalOptions="End" Spacing="10">
        <Button Text="Cancelar" Command="{Binding CancelCommand}" />
        <Button Text="Guardar" Command="{Binding SaveCommand}" />
      </HorizontalStackLayout>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
