<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
	<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst;net10.0-windows10.0.22621.0</TargetFrameworks>
	<OutputType>Exe</OutputType>
	<Nullable>enable</Nullable>
	<ImplicitUsings>enable</ImplicitUsings>
	<UseMaui>true</UseMaui>
	<SingleProject>true</SingleProject>
	<AndroidMinSdkVersion>21</AndroidMinSdkVersion>
	<!-- Use a supported minimum Android API; per-platform values below avoid applying Windows version to Android/iOS. -->
	<SupportedOSPlatformVersion Condition="'$(TargetFramework)'=='net10.0-android'">21.0</SupportedOSPlatformVersion>
	<SupportedOSPlatformVersion Condition="'$(TargetFramework)'=='net10.0-ios'">15.0</SupportedOSPlatformVersion>
	<SupportedOSPlatformVersion Condition="'$(TargetFramework)'=='net10.0-maccatalyst'">15.0.0</SupportedOSPlatformVersion>
	<SupportedOSPlatformVersion Condition="'$(TargetFramework)'=='net10.0-windows10.0.22621.0'">10.0.22621.0</SupportedOSPlatformVersion>
	<!-- Do not attempt MSIX packaging by default -->
	<WindowsPackageType>None</WindowsPackageType>

	<ApplicationTitle>Academia do Zé</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
	<ProjectReference Include="..\AcademiaDoZe.Application\AcademiaDoZe.Application.csproj" />
	<ProjectReference Include="..\AcademiaDoZe.Domain\AcademiaDoZe.Domain.csproj" />
	<ProjectReference Include="..\AcademiaDoZe.Infrastructure\AcademiaDoZe.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
	<MauiImage Remove="Resources\Images\academiadoze.png" />
	<MauiImage Include="Resources\Images\academiadoze.png" />
	<MauiIcon Include="Resources\Images\academiadoze.png">
	  <Link>ApplicationIcon\appicon.png</Link>
	</MauiIcon>
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.0" />
	<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
  </ItemGroup>

  <ItemGroup>
    <MauiXaml Update="Views\ConnectionPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\MatriculaListPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
    <MauiXaml Update="Views\MatriculaPage.xaml">
      <Generator>MSBuild:Compile</Generator>
    </MauiXaml>
  </ItemGroup>

</Project>
